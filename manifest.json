{
  "manifest_version": 3,
  "name": "My Vite Extension",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html"
  },
  "permissions":["activeTab","scripting","storage","offscreen"],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "content_scripts": [{
  "matches": ["*://*.youtube.com/*", "*://*.twitter.com/*","*://*.x.com/*","*://*.google.com/*","*://*.instagram.com/*"],
  "js": ["src/content/content.ts","src/content/youtube.ts", "src/content/x.ts", "src/content/instagram.ts","src/content/google.ts"]
}]
,"content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
  ,"web_accessible_resources": [
    {
      "resources": ["wasm/*.wasm"],
      "matches": ["<all_urls>"]
    }
  ]
}
