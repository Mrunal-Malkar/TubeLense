{
  "manifest_version": 3,
  "name": "TubeLense",
    "description": "See less noise. Watch more of what matters. Fast,Secure and Local for your youtube feed.",
  "version": "2.0",
  "action": {
     "default_popup": "index.html",
  "default_icon": {
    "16": "favicon.png",
    "32": "favicon.png"
  }
  },
  "icons": {
  "16": "favicon.png",
  "32": "favicon.png",
  "48": "favicon.png",
  "128": "favicon.png"
},
  "permissions":["activeTab","scripting","storage","offscreen"],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "content_scripts": [{
  "matches": ["*://*.youtube.com/*"],
  "js": ["src/content/content.ts","src/content/youtube.ts"]
}]
,"content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
  ,"web_accessible_resources": [
    {
      "resources": ["wasm/*.wasm"],
      "matches": ["<all_urls>"]
    }
  ]
}
